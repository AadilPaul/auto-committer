# Menu Settings/Keybinds:
# delete implementation lines before commit.
# All keybinds have been implemented.
open_settings_key="s"
run_script_key="r"
exit_key="e"
help_us_key="h"
guide_key="g"
# User UI/UX settings:
# Username is checked, show_menu_on_start is checked, greet_user_on_start is checked.
greet_user_on_start="true"
show_menu_on_start="true"
user_name=""
# Commit process settings
# add_command is checked, add_all_auto is implemented, auto_push is implemented, use_faster_script is implemented
add_all_auto="false"
add_command="git add ."
auto_push="false"
use_faster_script="false"

# default_branch="main" # Add branch support first.
default_dir="./"
# Tell the user to pull first. 
fail_on_conflict="true"
