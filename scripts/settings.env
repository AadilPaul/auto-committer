# Menu Settings/Keybinds:
open_settings_key="s"
run_script_key="r"
exit_key="e"
help_us_key="h"
# User UI/UX settings:
greet_user_on_start="true"
show_menu_on_start="true"
# You can edit this \/. My username is just a placeholder :).
user_name="AadilPaul"
# Commit process settings
add_all_auto="false"
add_command="git add ."
auto_push="false"
run_script_command="bash scripts/script.sh"
# default_branch="main"
default_dir="./"
# Tell the user to pull first.
fail_on_conflict="true"


